<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity" styleClass="retro-main-container" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codetravel.ui.RetroCombatController">
    
    <center>
        <Canvas fx:id="battleCanvas" height="280" styleClass="battle-canvas" width="380" />
    </center>
    
    <bottom>
        <ScrollPane fitToHeight="false" fitToWidth="true" styleClass="ui-scroll-pane">
            <VBox maxWidth="Infinity" spacing="8" styleClass="ui-panel">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>
                
                <VBox alignment="CENTER" spacing="4">
                    <Label fx:id="messageLabel" alignment="CENTER" maxWidth="Infinity" styleClass="message-text" text="Дикий SENTINEL преграждает путь!" wrapText="true" />
                    <Label fx:id="taskLabel" alignment="CENTER" maxWidth="Infinity" styleClass="task-text" text="Нажмите 'АТАКА'" wrapText="true" />
                </VBox>
                
                <HBox alignment="CENTER" maxWidth="Infinity" spacing="8">
                    <TextField fx:id="answerField" promptText="Введите ответ..." styleClass="answer-field" HBox.hgrow="ALWAYS" />
                    <Button fx:id="fightButton" onAction="#handleAttack" styleClass="fight-button" text="АТАКА" />
                </HBox>
                
                <HBox alignment="CENTER" maxWidth="Infinity" spacing="6">
                    <Button fx:id="hintButton" styleClass="hint-button" text="💡 ПОДСКАЗКА" />
                    <Button fx:id="runButton" styleClass="run-button" text="🏃 СБЕЖАТЬ" />
                </HBox>
                
                <VBox spacing="6" styleClass="items-panel">
                    <Label styleClass="items-title" text="🎒 ПРЕДМЕТЫ" />
                    <HBox alignment="CENTER" spacing="6">
                        <Button fx:id="useHealthPotionBtn" styleClass="item-button" text="❤" />
                        <Button fx:id="useExpPotionBtn" styleClass="item-button" text="⭐" />
                        <Button fx:id="useStrengthPotionBtn" styleClass="item-button" text="💪" />
                    </HBox>
                    <Label fx:id="itemsCountLabel" styleClass="items-count" text="Предметы: 0" />
                </VBox>
                
                <HBox alignment="CENTER" spacing="15">
                    <Label fx:id="playerHPLabel" styleClass="hp-label" text="USER_ROOT: 100/100" />
                    <Label fx:id="enemyHPLabel" styleClass="hp-label" text="SENTINEL.EXE: 100/100" />
                </HBox>
            </VBox>
        </ScrollPane>
    </bottom>
    
</BorderPane>
